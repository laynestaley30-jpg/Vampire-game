function parseJSON(text){
  let t = String(text || "").replace(/<think>[\s\S]*?<\/think>/gi, "").trim();
  const fence = t.match(/```(?:json)?\s*([\s\S]*?)```/i);
  if (fence) t = fence[1].trim();
  try { return JSON.parse(t); } catch(e){}
  const a = t.indexOf("{"), b = t.lastIndexOf("}");
  if (a !== -1 && b > a){
    try { return JSON.parse(t.slice(a, b + 1)); } catch(e){}
  }
  throw { code:"invalid_json", message:"The reply did not contain usable JSON" };
}

async function chatJSON(prompt){
  const bases = [SETTINGS.base, "https://text.pollinations.ai/openai"];
  let last;
  for (const b of bases){ try { return await chatJSONAt(prompt, b); } catch(e){ last = e; if (e && e.code === "invalid_json") throw e; } }
  throw last;
}
async function chatJSONAt(prompt, baseUrl){
  const base = baseUrl.trim().replace(/\/+$/, "");
  const model = SETTINGS.model.trim();
  if (!base || !model) throw { code:"upstream_error", message:"The AI server address or model name is empty" };
  const send = async jsonMode => {
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), 90000);
    try {
      const headers = { "Content-Type":"application/json" };
      if (SETTINGS.key.trim()) headers.Authorization = "Bearer " + SETTINGS.key.trim();
      const body = { model, messages:[{ role:"user", content:prompt }], temperature:0.8, stream:false };
      if (jsonMode) body.response_format = { type:"json_object" };
      return await fetch(base + "/chat/completions", { method:"POST", headers, body:JSON.stringify(body), signal:ctl.signal });
    } catch(e){
      if (e && e.name === "AbortError") throw { code:"upstream_error", message:"The AI took too long to answer" };
      throw { code:"upstream_error", message:"Could not reach " + base + ". Check the address and that the server is running. For Ollama, start it with OLLAMA_ORIGINS=\"*\" so a local file may connect" };
    } finally { clearTimeout(timer); }
  };
  let res = await send(SETTINGS.json);
  if (!res.ok && SETTINGS.json && (res.status === 400 || res.status === 422)) res = await send(false);
  if (!res.ok){
    let txt = ""; try { txt = (await res.text()).slice(0, 160); } catch(e){}
    throw { code:"upstream_error", message:"The server answered " + res.status + (txt ? ": " + txt : "") };
  }
  let data;
  try { data = await res.json(); } catch(e){ throw { code:"upstream_error", message:"The server sent something that was not JSON" }; }
  const content = data && data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content;
  return parseJSON(content);
}

