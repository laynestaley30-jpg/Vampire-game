<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Suck Up!</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chivo+Mono:wght@400;600&family=Pirata+One&family=Spectral:ital,wght@0,400;0,600;1,400&display=swap">
<style>
/* Layout: a night street of six lit doors under a sky that brightens toward dawn; each doorstep plays as a conversation. */
:root{
  --night:#0a0f24; --night-2:#141c40; --panel:#101734; --panel-2:#17204a; --edge:#2a3568;
  --moon:#dbe4ff; --mist:#93a0cf; --lamp:#ffb454; --blood:#e0274f; --blood-dim:#4a1230; --good:#7ee0b0;
  --wall:#1b2552; --dark-window:#0d1230;
  --font-display:"Pirata One","Palatino Linotype",Georgia,serif;
  --font-voice:"Spectral",Georgia,serif;
  --font-ui:"Chivo Mono",ui-monospace,Menlo,Consolas,monospace;
  --dawn:0;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{margin:0}
[hidden]{display:none!important}
body{
  background-color:var(--night);
  background-image:
    radial-gradient(1.5px 1.5px at 8% 12%,#ffffffb0 50%,transparent 52%),
    radial-gradient(1px 1px at 22% 30%,#ffffff80 50%,transparent 52%),
    radial-gradient(1.5px 1.5px at 41% 9%,#ffffffa0 50%,transparent 52%),
    radial-gradient(1px 1px at 58% 24%,#ffffff70 50%,transparent 52%),
    radial-gradient(1.5px 1.5px at 73% 14%,#ffffffb0 50%,transparent 52%),
    radial-gradient(1px 1px at 88% 34%,#ffffff80 50%,transparent 52%),
    linear-gradient(180deg,#060a1c 0%,var(--night-2) 75%);
  background-attachment:fixed;
  color:var(--moon);
  font-family:var(--font-ui);
  font-size:14px;
  line-height:1.5;
  padding-block:16px 56px;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
  min-height:100%;
}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;opacity:var(--dawn);transition:opacity 1.2s ease;
  background:linear-gradient(0deg,#ff9a55 0%,#ff5e7040 38%,transparent 70%)}
.app{position:relative;z-index:1;max-width:980px;margin:0 auto;display:flex;flex-direction:column;gap:20px}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible{outline:2px solid var(--lamp);outline-offset:2px}
button[disabled]{cursor:not-allowed;opacity:.45}

/* HUD */
.hud{display:grid;grid-template-columns:auto 1fr 1fr auto;gap:16px;align-items:end;padding-bottom:14px;border-bottom:1px solid var(--edge)}
.brand{font-family:var(--font-display);font-size:42px;line-height:1;color:var(--moon);letter-spacing:.02em}
.brand i{font-style:normal;color:var(--blood)}
.gauge{display:flex;flex-direction:column;gap:4px;min-width:0}
.gauge .k{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--mist)}
.gauge b{font-size:18px;font-weight:600;font-variant-numeric:tabular-nums}
.gauge .sub{font-size:12px;color:var(--mist)}
.bar{height:6px;background:#0a0f26;border:1px solid var(--edge);border-radius:3px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--lamp);transition:width .5s ease}
.blood .bar i{background:var(--blood)}
.blood.sated b{color:var(--good)}
.blood .bar{position:relative}
.pips{display:flex;gap:6px;padding-top:4px}
.pip{width:14px;height:14px;border:1.5px solid var(--edge);transform:rotate(45deg);background:transparent}
.pip.on{background:var(--blood);border-color:var(--blood)}

/* Shared panels */
.panel{background:var(--panel);border:1px solid var(--edge);border-radius:6px;padding:20px}
h1,h2,h3{margin:0;text-wrap:balance}
h2{font-family:var(--font-display);font-size:30px;font-weight:400;letter-spacing:.02em}
.lede{font-family:var(--font-voice);font-size:19px;color:var(--moon);max-width:60ch;margin:0}
.muted{color:var(--mist)}
.btn{background:var(--panel-2);border:1px solid var(--edge);border-radius:4px;padding:10px 14px;transition:border-color .15s,background .15s}
.btn:hover:not([disabled]){border-color:var(--lamp)}
.btn.primary{background:var(--blood);border-color:var(--blood);color:#fff;font-weight:600}
.btn.primary:hover:not([disabled]){background:#f23a62;border-color:#f23a62}
.row{display:flex;flex-wrap:wrap;gap:10px}

/* Intro */
.intro{display:grid;gap:18px}
.intro .title{font-family:var(--font-display);font-size:clamp(64px,14vw,120px);line-height:.9;margin:0}
.intro .title i{font-style:normal;color:var(--blood)}
.rules{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin:0;padding:0;list-style:none}
.rules li{border-top:1px solid var(--edge);padding-top:10px;color:var(--mist);font-size:13px}
.rules b{display:block;color:var(--moon);font-size:12px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:4px}
.fine{font-size:12px;color:var(--mist);margin:0}

/* Street */
.street-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:8px}
.lane{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;padding-bottom:18px;border-bottom:3px solid #1d2658;position:relative}
.house{display:flex;flex-direction:column;gap:8px;text-align:left;background:var(--panel);border:1px solid var(--edge);border-radius:6px;padding:12px;min-width:0;transition:border-color .15s,transform .15s}
.house:hover:not([disabled]){border-color:var(--lamp);transform:translateY(-2px)}
.house svg{width:100%;height:auto;display:block;max-width:100%}
.house .no{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--lamp)}
.house .who{font-family:var(--font-voice);font-size:17px;font-weight:600}
.house .glimpse{font-family:var(--font-voice);font-style:italic;color:var(--mist);font-size:14px;line-height:1.4}
.house .status{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--mist)}
.house[data-status="fed"] .status{color:var(--good)}
.house[data-status="slammed"] .status,.house[data-status="barred"] .status{color:var(--blood)}
.h-body{fill:var(--wall)}
.h-door{fill:#0d1230}
.h-win{fill:var(--lamp)}
.h-win-glow{fill:var(--lamp);opacity:.18}
[data-status="fed"] .h-win{fill:var(--dark-window)}
[data-status="fed"] .h-win-glow{opacity:0}
[data-status="barred"] .h-win,[data-status="slammed"] .h-win{fill:#7a5a2c}
.h-board{stroke:#8a6a3a;stroke-width:4}
@media (prefers-reduced-motion:no-preference){.h-win{animation:flicker 5s infinite steps(1)}@keyframes flicker{0%,92%,100%{opacity:1}94%{opacity:.7}96%{opacity:1}98%{opacity:.8}}}
.actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between}

/* Door */
.door-head{display:grid;grid-template-columns:92px 1fr;gap:16px;align-items:center}
.door-head svg{width:92px;height:auto}
.door-head .no{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--lamp)}
.door-head .nm{font-family:var(--font-voice);font-size:22px;font-weight:600;line-height:1.2}
.meters{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:10px}
.m span{display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--mist);margin-bottom:4px}
.m.trust .bar i{background:var(--good)}
.m.susp .bar i{background:var(--blood)}
.mood{font-size:12px;color:var(--mist);margin-top:8px}
.mood b{color:var(--lamp);font-weight:600}
.guises{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}
.guise{text-align:left;background:var(--panel-2);border:1px solid var(--edge);border-radius:4px;padding:12px;display:flex;flex-direction:column;gap:4px;min-width:0}
.guise:hover{border-color:var(--lamp)}
.guise b{font-size:14px}
.guise span{font-size:12px;color:var(--mist)}
.log{display:flex;flex-direction:column;gap:12px;max-height:340px;overflow-y:auto;padding-right:4px}
.bub{max-width:88%;padding:10px 14px;border-radius:6px;font-family:var(--font-voice);font-size:17px;line-height:1.45;overflow-wrap:anywhere}
.bub.them{align-self:flex-start;background:var(--panel-2);border:1px solid var(--edge)}
.bub.you{align-self:flex-end;background:var(--blood-dim);border:1px solid #7a1f45;font-style:italic}
.bub.note{align-self:center;max-width:100%;background:transparent;border:1px dashed var(--edge);font-family:var(--font-ui);font-size:12px;color:var(--mist);font-style:normal;text-align:center}
.bub .mv{display:block;margin-top:6px;font-family:var(--font-ui);font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-style:normal}
.mv.warmer{color:var(--good)} .mv.colder{color:var(--blood)} .mv.unmoved{color:var(--mist)}
.choices{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}
.choice{text-align:left;background:var(--panel-2);border:1px solid var(--edge);border-radius:4px;padding:10px 12px;display:flex;flex-direction:column;gap:4px;min-width:0}
.choice:hover{border-color:var(--lamp)}
.choice .tag{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--lamp)}
.choice .line{font-family:var(--font-voice);font-size:15px;line-height:1.4}
.mode{display:flex;flex-wrap:wrap;gap:8px}
.mode .btn.on{border-color:var(--lamp);background:#2a2a3e;color:var(--lamp)}
.badge{display:inline-block;margin-left:6px;padding:1px 8px;border:1px solid var(--edge);border-radius:10px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--lamp);white-space:nowrap}
.bub.typing{color:var(--mist);font-style:italic}
@media (prefers-reduced-motion:no-preference){.bub.typing{animation:pulse 1.2s ease-in-out infinite}@keyframes pulse{50%{opacity:.45}}}
.ai-panel{display:grid;gap:14px}
.fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.field{display:flex;flex-direction:column;gap:4px;min-width:0}
.field span{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mist)}
.field input{background:#0a0f26;border:1px solid var(--edge);border-radius:4px;color:var(--moon);font:inherit;padding:10px 12px;min-width:0}
.check{display:flex;gap:8px;align-items:flex-start;font-size:13px;color:var(--mist)}
.status-line{color:var(--lamp)}
.say{display:flex;gap:8px}
.say input{flex:1;min-width:0;background:#0a0f26;border:1px solid var(--edge);border-radius:4px;color:var(--moon);font:inherit;padding:10px 12px}
.bite{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}
.bite .choice .line{color:var(--mist);font-size:14px}

/* End */
.end{display:grid;gap:16px}
.end .rank{font-family:var(--font-display);font-size:clamp(48px,11vw,88px);line-height:.95;margin:0}
.end.win .rank{color:var(--good)}
.end.lose .rank{color:var(--blood)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;margin:0}
.stats div{border-top:1px solid var(--edge);padding-top:8px}
.stats dt{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--mist)}
.stats dd{margin:0;font-size:20px;font-weight:600;font-variant-numeric:tabular-nums}

@media (max-width:640px){
  .hud{grid-template-columns:1fr 1fr}
  .brand{grid-column:1/-1;font-size:38px}
  .meters{grid-template-columns:1fr}
  .bub{max-width:96%}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
.world-slot{position:relative;height:min(64vh,560px);border:1px solid var(--edge);border-radius:6px;overflow:hidden;touch-action:none;background:#0a0f26}
.world3d,.world3d canvas{width:100%;height:100%;display:block}
.world3d{position:relative}
.w3-help{position:absolute;top:8px;left:10px;font-size:12px;color:var(--mist);pointer-events:none;text-shadow:0 1px 3px #000}
.w3-prompt{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);max-width:92%;background:#0a0f26e6;border:1px solid var(--edge);border-radius:6px;padding:10px 14px;text-align:center;font-size:13px}
.w3-prompt i{color:var(--mist);font-family:var(--font-voice)}
.w3-prompt .btn{margin-top:6px}
.w3-pad{display:none;position:absolute;left:10px;bottom:10px;flex-direction:column;align-items:center;gap:4px}
.w3-pad div{display:flex;gap:4px}
.w3-pad button{width:42px;height:42px;background:#0a0f26cc;border:1px solid var(--edge);border-radius:6px;touch-action:none}
.w3-knock{display:none;position:absolute;right:12px;bottom:12px;width:84px;height:84px;border-radius:50%;background:#8a1020;border:2px solid var(--lamp);font-weight:600}
.w3-knock[disabled]{background:#0a0f26cc;border-color:var(--edge)}
@media (hover:none){.w3-pad{display:flex}.w3-knock{display:block}.w3-prompt{top:8px;bottom:auto;transform:translateX(-50%)}.w3-prompt .btn{display:none}.w3-help{display:none}}

/* Game-style doorstep scene */
.scene{position:relative;height:min(56vw,400px);min-height:290px;border-radius:8px;overflow:hidden;border:1px solid var(--edge);background:linear-gradient(#0b1230,#1a1740 70%,#2a1a2e);}
.scene::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,#3a1f1f 0 46px,#2e1818 46px 48px);opacity:.55}
.doorway{position:absolute;left:6%;bottom:0;width:48%;height:94%;border:7px solid #4a3426;border-bottom:0;background:radial-gradient(ellipse at 50% 30%,#ffd98a,#c98f4a 75%);box-shadow:0 0 60px #ffb45455}
.res{position:absolute;left:11%;bottom:0;height:84%;width:38%}
.me{position:absolute;right:3%;bottom:-8px;height:62%;width:42%}
.res svg,.me svg{width:100%;height:100%}
.tag3{position:absolute;left:-14px;top:-14px;background:linear-gradient(90deg,#1f8f5a,#46c98a);color:#fff;font:800 italic 15px/1 "Trebuchet MS","Segoe UI",system-ui,sans-serif;padding:5px 22px 5px 16px;letter-spacing:.03em;clip-path:polygon(0 0,100% 0,92% 100%,6% 100%);z-index:4;text-shadow:0 1px 0 #0006}
.tag3.solo{left:12px;top:12px}
.bubble{position:absolute;left:5%;top:26px;max-width:60%;z-index:3;filter:drop-shadow(3px 0 0 #111) drop-shadow(-3px 0 0 #111) drop-shadow(0 3px 0 #111) drop-shadow(0 -3px 0 #111)}
.bubble .bi{position:relative;background:#f4f4f4;color:#111;padding:20px 22px 40px;clip-path:polygon(0 5%,100% 0,98% 82%,72% 84%,66% 100%,58% 84%,2% 92%);font:800 clamp(13px,3.2vw,18px)/1.3 "Trebuchet MS","Segoe UI",system-ui,sans-serif}
.bubble .mv{display:inline-block;margin-left:8px;font:600 10px var(--font-ui);letter-spacing:.1em;text-transform:uppercase;color:#777}
.leave3{position:absolute;right:12px;bottom:14px;z-index:4;background:#d4151c;color:#fff;border:3px solid #fff;font:900 clamp(11px,2.4vw,15px) "Trebuchet MS","Segoe UI",system-ui,sans-serif;letter-spacing:.04em;padding:8px 18px;transform:skewX(-10deg);box-shadow:3px 3px 0 #000;cursor:pointer}
.leave3[disabled]{opacity:.6}
.scene .meters{position:absolute;right:10px;top:10px;width:36%;margin:0;gap:8px;z-index:3}
.scene .badge{position:absolute;right:10px;bottom:54px;z-index:3}
.scene::after{content:"🎤 Tap Talk below to record voice";position:absolute;left:12px;bottom:8px;z-index:3;font:600 11px var(--font-ui);color:#fff;text-shadow:0 1px 3px #000}
.gbar{display:grid;gap:12px;margin-top:10px}
.gbar .say{background:#000;border:0;border-radius:0;padding:6px 6px 6px 14px}
.gbar .say .btn[type=submit]{clip-path:polygon(12px 0,100% 0,100% 100%,0 100%);padding-left:22px}
.gbar .say input{border:0;background:transparent}
.gbar .say .btn[type=submit]{background:#2a3568;font-weight:700;letter-spacing:.12em}
.hist summary{cursor:pointer;font-size:12px;color:var(--mist)}
.t3d{position:absolute;inset:0;z-index:1}.t3d canvas{width:100%;height:100%;display:block}

</style>

</head>
<body>
<div class="app" id="app"></div>

<script>
"use strict";
const DAWN = 510;            // minutes after 9:00 PM until sunrise
const GOAL = 100;            // blood needed to call the night a success
const MAXHEAT = 3;
const START_MIN = 21 * 60;

const TAGS = { charm:"Charm", flatter:"Flatter", sob:"Sob story", offer:"Offer", bluff:"Bluff", menace:"Menace" };

const GUISES = [
  { id:"courier",   name:"Pizza courier",     blurb:"Hot box, wrong address, big smile." },
  { id:"lost",      name:"Lost traveler",     blurb:"Dead phone, kind face." },
  { id:"canvass",   name:"Charity canvasser", blurb:"Clipboard and a cause." },
  { id:"neighbor",  name:"New neighbor",      blurb:"Borrowing a cup of anything." },
  { id:"inspector", name:"Utility inspector", blurb:"Hi-vis vest, official voice." }
];

/* Outfits and props taken from residents you drink deep from */
const DROPS = {
  drop_marge:  { name:"Marge's cardigan", blurb:"Soft wool, reading glasses, a library card.", prop:"Library card", fits:["dex","rosa"],
                 aff:{marge:-2,dex:1,rosa:2,pruitt:0,imani:1,haskell:1} },
  drop_dex:    { name:"Dex's hoodie", blurb:"Faded hoodie, headphones, a dead phone.", prop:"Dead phone", fits:["marge","imani"],
                 aff:{marge:0,dex:-2,rosa:-1,pruitt:-1,imani:1,haskell:0} },
  drop_rosa:   { name:"Rosa's chef whites", blurb:"Stained apron and a tin of pastries.", prop:"Pastry tin", fits:["marge","dex","pruitt"],
                 aff:{marge:2,dex:2,rosa:-2,pruitt:1,imani:1,haskell:1} },
  drop_pruitt: { name:"Officer Pruitt's jacket", blurb:"Dark jacket, flashlight, a shiny badge.", prop:"Badge", fits:["marge","rosa","imani"],
                 aff:{marge:1,dex:-1,rosa:1,pruitt:-2,imani:2,haskell:1} },
  drop_imani:  { name:"Dr. Okafor's scrubs", blurb:"Hospital scrubs and a stethoscope.", prop:"Stethoscope", fits:["marge","pruitt","haskell"],
                 aff:{marge:2,dex:1,rosa:1,pruitt:1,imani:-2,haskell:1} },
  drop_haskell:{ name:"Haskell's waistcoat", blurb:"Brass buttons and a ticking pocket watch.", prop:"Pocket watch", fits:["marge","imani"],
                 aff:{marge:2,dex:0,rosa:1,pruitt:1,imani:1,haskell:-2} }
};
function guiseOf(id){ return DROPS[id] || GUISES.find(x => x.id === id) || { name:"stranger", blurb:"" }; }

const RES = [
  { id:"marge", name:"Marge Pellew", title:"Mrs. Pellew", role:"Retired librarian, 71", no:4,
    glimpse:"A kettle whistles somewhere inside. Lamplight falls on a tower of paperbacks.",
    opening:"The chain rattles. “Who is it at this hour? Yes?”",
    w:{charm:1,flatter:2,sob:2,offer:1,bluff:-1,menace:-3},
    aff:{courier:-1,lost:2,canvass:0,neighbor:2,inspector:-1},
    baseSusp:0, ward:0, slamHeat:1, drainHeat:1, value:20, vamp:false,
    likes:["book","read","tea","librar","garden","cat","novel","poem","story","cookie","shortbread"],
    dislikes:["loud","hurry","buy","sell","money","rude"],
    lines:{
      charm:"Such a lovely night for a visit, Mrs. Pellew. I saw your lamp on.",
      flatter:"I hope you don't mind me saying, yours is the prettiest garden on Larkspur Lane.",
      sob:"I'm so sorry to trouble you. I've been walking for hours and I'm terribly cold.",
      offer:"I brought a tin of shortbread. I thought someone might share a cup of tea.",
      bluff:"Records check for the library board. It will take two minutes.",
      menace:"Open the door, Marge. Don't make this unpleasant."},
    react:{
      great:"“Oh, you poor dear. Goodness, I haven't had a visitor in ages.”",
      good:"“Well. That's rather sweet of you to say.”",
      meh:"“Hm. I'm not sure what to make of that.”",
      bad:"“I don't care for your tone, young person.”",
      awful:"“I shall telephone someone if you carry on like that.”"},
    invite:"“Come in, come in, before the cold gets in. I'll put the kettle on.”",
    slam:"“Good night, dear. I'm sure I can't help you.” The bolt slides home." },

  { id:"dex", name:"Dex Moreno", title:"Dex", role:"College student, 20", no:7,
    glimpse:"Blue TV flicker and bass through the wall. Pizza boxes stacked in the window.",
    opening:"The door cracks open, headphones around his neck. “Yeah? You ordering something?”",
    w:{charm:1,flatter:0,sob:1,offer:2,bluff:-2,menace:-1},
    aff:{courier:2,lost:0,canvass:-1,neighbor:1,inspector:-2},
    baseSusp:0, ward:0, slamHeat:1, drainHeat:1, value:25, vamp:true,
    likes:["game","pizza","horror","movie","cosplay","halloween","stream","band","music","free","hungry","energy"],
    dislikes:["lecture","formal","rent","survey","official"],
    lines:{
      charm:"Hey man, whatever you're playing sounds intense. Mind if I say hi?",
      flatter:"That stream setup of yours is unreal. Did you build it yourself?",
      sob:"My ride bailed and I'm starving. Any chance you've got spare food?",
      offer:"I've got a free pizza nobody claimed. All yours, no strings.",
      bluff:"Property office. We need to check your smoke alarm tonight.",
      menace:"Open up. You really don't want me out here all night."},
    react:{
      great:"“Ha! Okay, you're actually cool. Hold on, let me pause my game.”",
      good:"“Huh. Okay, that's kind of funny.”",
      meh:"“Uh. Cool, I guess? It's one in the morning, man.”",
      bad:"“Dude, that's weirdly intense. Dial it back.”",
